      "warning": "#E8A838",
      "error": "#DC2626",
      "info": "#3686D6",
      "surface": "#F4F4F0",
      "card": "#FFFFFF",
      "charcoal": "#2D2D2D",
      "primaryBg": "#E7F0EA",
      "accentBg": "#FAF5E8",
      "successBg": "#E7F8ED",
      "warningBg": "#FEF4E3",
