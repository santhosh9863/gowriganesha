        "headlineMedium": { "size": 20, "weight": 600 },
        "headlineSmall": { "size": 18, "weight": 600 },
        "titleLarge": { "size": 16, "weight": 600 },
        "titleMedium": { "size": 14, "weight": 600 },
        "titleSmall": { "size": 13, "weight": 500 },
        "bodyLarge": { "size": 15, "weight": 400 },
        "bodyMedium": { "size": 14, "weight": 400 },
        "bodySmall": { "size": 13, "weight": 400 },
        "labelLarge": { "size": 12, "weight": 600 },
        "labelMedium": { "size": 11, "weight": 500 },
        "labelSmall": { "size": 10, "weight": 500 }
      }
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 20,
      "xxl": 24,
      "xxxl": 32,
      "xxxxl": 40
    },
    "radius": {
      "small": 8,
      "medium": 12,
      "large": 16,
      "hero": 24,
      "full": 999
