class _CollectionTrend extends ConsumerWidget {
  final DashboardData dashboard;
  final String Function(int) fmt;
  const _CollectionTrend({required this.dashboard, required this.fmt});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final theme = Theme.of(context);
    final cs = theme.colorScheme;
    final chartData = ref.watch(dailyChartProvider);

    final totalInPeriod = chartData.fold<int>(0, (v, p) => v + p.amount);
    final spots = chartData.asMap().entries.map((e) {
      return FlSpot(e.key.toDouble(), e.value.amount.toDouble());
    }).toList();

    return Container(
      padding: const EdgeInsets.all(AppSpacing.xl),
      decoration: BoxDecoration(
        color: cs.surface,
        borderRadius: AppRadius.cardBorder,
        border: Border.all(color: cs.outlineVariant.withAlpha(80)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              Container(
                padding: const EdgeInsets.all(8),
                decoration: BoxDecoration(
                  color: cs.tertiary.withAlpha(20),
                  borderRadius: BorderRadius.circular(10),
                ),
                child: Icon(
                  Icons.bar_chart_rounded,
                  size: 20,
                  color: cs.tertiary,
                ),
              ),
              const SizedBox(width: AppSpacing.sm),
              Text(
                'Collection Trend',
                style: theme.textTheme.titleSmall?.copyWith(
                  fontWeight: FontWeight.w600,
                  color: cs.onSurfaceVariant,
                ),
              ),
              const Spacer(),
              Text(
                '14 days',
                style: theme.textTheme.labelSmall?.copyWith(
                  color: cs.onSurface.withAlpha(120),
                ),
              ),
            ],
          ),
          const SizedBox(height: AppSpacing.lg),
          SizedBox(
            height: 180,
            child: spots.isEmpty || spots.every((s) => s.y == 0)
                ? Center(
                    child: Text(
                      'No collection data yet',
                      style: theme.textTheme.bodySmall?.copyWith(
                        color: cs.onSurfaceVariant,
                      ),
                    ),
                  )
                : LineChart(
                    LineChartData(
                      gridData: FlGridData(
                        show: true,
                        drawVerticalLine: false,
                        horizontalInterval: _roundInterval(
                          chartData.map((e) => e.amount).reduce((a, b) => a > b ? a : b).toDouble(),
                        ),
                        getDrawingHorizontalLine: (value) => FlLine(
                          color: cs.outlineVariant.withAlpha(60),
                          strokeWidth: 1,
                        ),
                      ),
                      titlesData: FlTitlesData(
                        topTitles: const AxisTitles(sideTitles: SideTitles(showTitles: false)),
                        rightTitles: const AxisTitles(sideTitles: SideTitles(showTitles: false)),
                        leftTitles: AxisTitles(
                          sideTitles: SideTitles(
                            showTitles: true,
                            reservedSize: 40,
                            getTitlesWidget: (value, meta) {
                              if (value == 0) return const SizedBox.shrink();
                              return Padding(
                                padding: const EdgeInsets.only(right: 4),
                                child: Text(
                                  _shortFmt(value.toInt()),
                                  style: theme.textTheme.labelSmall?.copyWith(
                                    color: cs.onSurface.withAlpha(100),
                                    fontSize: 10,
                                  ),
                                ),
                              );
                            },
                          ),
                        ),
                        bottomTitles: AxisTitles(
                          sideTitles: SideTitles(
                            showTitles: true,
                            reservedSize: 20,
                            interval: chartData.length > 10 ? 2 : 1,
                            getTitlesWidget: (value, meta) {
                              final idx = value.toInt();
                              if (idx < 0 || idx >= chartData.length) return const SizedBox.shrink();
                              return Padding(
                                padding: const EdgeInsets.only(top: 4),
                                child: Text(
                                  chartData[idx].label,
                                  style: theme.textTheme.labelSmall?.copyWith(
                                    color: cs.onSurface.withAlpha(100),
                                    fontSize: 9,
                                  ),
                                ),
                              );
                            },
                          ),
                        ),
                      ),
                      borderData: FlBorderData(show: false),
                      lineBarsData: [
                        LineChartBarData(
                          spots: spots,
                          isCurved: true,
                          preventCurveOverShooting: true,
                          color: cs.tertiary,
                          barWidth: 3,
                          isStrokeCapRound: true,
                          dotData: const FlDotData(show: false),
                          belowBarData: BarAreaData(
                            show: true,
                            color: cs.tertiary.withAlpha(25),
                          ),
                        ),
                      ],
                      lineTouchData: LineTouchData(
                        enabled: true,
                        touchTooltipData: LineTouchTooltipData(
                          getTooltipItems: (touchedSpots) {
                            return touchedSpots.map((spot) {
                              final idx = spot.spotIndex;
                              final label = idx < chartData.length ? chartData[idx].label : '';
                              return LineTooltipItem(
                                '$label\n${AppConstants.currencySymbol}${_shortFmt(spot.y.toInt())}',
                                TextStyle(
                                  color: cs.surface,
                                  fontWeight: FontWeight.w600,
                                  fontSize: 12,
                                ),
                              );
                            }).toList();
                          },
                        ),
                      ),
                    ),
                  ),
          ),
          const SizedBox(height: AppSpacing.md),
          Row(
            children: [
              Text(
                '${AppConstants.currencySymbol}${fmt(totalInPeriod)}',
                style: theme.textTheme.titleSmall?.copyWith(
                  fontWeight: FontWeight.bold,
                  color: cs.tertiary,
                ),
              ),
              const SizedBox(width: AppSpacing.xs),
              Text(
                'total in 14 days',
                style: theme.textTheme.labelSmall?.copyWith(
                  color: cs.onSurface.withAlpha(120),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

double _roundInterval(double maxVal) {
  if (maxVal <= 0) return 1000;
  final order = _orderOfMagnitude(maxVal);
  final normalized = maxVal / order;
  if (normalized <= 2) return 0.5 * order;
  if (normalized <= 5) return 1 * order;
  return 2 * order;
}

double _orderOfMagnitude(double val) {
  if (val <= 0) return 1;
  final exp = (math.log(val.abs()) / math.log(10) - 1).ceil();
  if (exp < 0) return 1;
  return double.parse('1e$exp');
}

String _shortFmt(int n) {
  if (n >= 100000) return '${(n / 100000).toStringAsFixed(1)}L';
  if (n >= 1000) return '${(n / 1000).toStringAsFixed(1)}K';
  return n.toString();
}

