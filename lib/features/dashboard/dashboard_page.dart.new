class DashboardPage extends ConsumerStatefulWidget {
  const DashboardPage({super.key});

  @override
  ConsumerState<DashboardPage> createState() => _DashboardPageState();
}

class _DashboardPageState extends ConsumerState<DashboardPage> {
  static bool _hasPlayedIntro = false;

  @override
  void initState() {
    super.initState();
    if (!_hasPlayedIntro) {
      _hasPlayedIntro = true;
    }
  }

  String _fmt(int n) => NumberFormat('#,##,###', 'en_IN').format(n);

  @override
  Widget build(BuildContext context) {
    final dashboard = ref.watch(dashboardProvider);

    return Scaffold(
      appBar: AppBar(
        title: const Text('Dashboard'),
        actions: [
          IconButton(
            icon: const Icon(Icons.settings_rounded),
            tooltip: 'Settings',
            onPressed: () => context.push('/settings'),
          ),
        ],
      ),
      body: RefreshIndicator(
        onRefresh: () async {
          ref.invalidate(dashboardProvider);
          ref.invalidate(activitiesStreamProvider);
          ref.invalidate(activeFollowUpsProvider);
          ref.invalidate(dailyChartProvider);
        },
        child: LayoutBuilder(
          builder: (context, constraints) {
            final width = constraints.maxWidth;
            final isWide = width > 900;
            final isMedium = width > 600;

            return SingleChildScrollView(
              padding: const EdgeInsets.fromLTRB(
                AppSpacing.lg,
                AppSpacing.sm,
                AppSpacing.lg,
                AppSpacing.xxxl,
              ),
              child: isWide
                  ? _WideLayout(dashboard: dashboard, fmt: _fmt)
                  : isMedium
                      ? _MediumLayout(dashboard: dashboard, fmt: _fmt)
                      : _NarrowLayout(dashboard: dashboard, fmt: _fmt),
            );
          },
        ),
      ),
    );
  }
}

class _WideLayout extends StatelessWidget {
  final DashboardData dashboard;
  final String Function(int) fmt;
  const _WideLayout({required this.dashboard, required this.fmt});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Expanded(flex: 2, child: _GoalProgress(dashboard: dashboard, fmt: fmt)),
            const SizedBox(width: AppSpacing.lg),
            Expanded(flex: 1, child: _BalanceCard(dashboard: dashboard, fmt: fmt)),
          ],
        ),
        const SizedBox(height: AppSpacing.lg),
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Expanded(flex: 2, child: _CollectionTrend(dashboard: dashboard, fmt: fmt)),
            const SizedBox(width: AppSpacing.lg),
            Expanded(flex: 1, child: _QuickStats(dashboard: dashboard, fmt: fmt)),
          ],
        ),
        const SizedBox(height: AppSpacing.xxl),
        _RecentActivityCard(),
      ],
    );
  }
}

class _MediumLayout extends StatelessWidget {
  final DashboardData dashboard;
  final String Function(int) fmt;
  const _MediumLayout({required this.dashboard, required this.fmt});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        _GoalProgress(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.lg),
        Row(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Expanded(child: _BalanceCard(dashboard: dashboard, fmt: fmt)),
            const SizedBox(width: AppSpacing.lg),
            Expanded(child: _QuickStats(dashboard: dashboard, fmt: fmt)),
          ],
        ),
        const SizedBox(height: AppSpacing.lg),
        _CollectionTrend(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.xxl),
        _RecentActivityCard(),
      ],
    );
  }
}

class _NarrowLayout extends StatelessWidget {
  final DashboardData dashboard;
  final String Function(int) fmt;
  const _NarrowLayout({required this.dashboard, required this.fmt});

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        _GoalProgress(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.md),
        _BalanceCard(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.md),
        _CollectionTrend(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.md),
        _QuickStats(dashboard: dashboard, fmt: fmt),
        const SizedBox(height: AppSpacing.xxl),
        _RecentActivityCard(),
      ],
    );
  }
}

class _GoalProgress extends StatelessWidget {
