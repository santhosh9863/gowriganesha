                ),
                const SizedBox(width: AppSpacing.md),
                Container(width: 1, height: 36, color: cs.outlineVariant),
                const SizedBox(width: AppSpacing.md),
                _MiniStat(
                  label: 'Remaining',
                  value: '${AppConstants.currencySymbol}${fmt(dashboard.remainingCollection)}',
